# Example relayd(8) TLS termination in front of weft (which listens on
# 127.0.0.1:8080). relayd handles the public TLS; weft speaks plain HTTP on
# localhost only.
#
# Put the certificate at /etc/ssl/weft.example.org.crt and the key at
# /etc/ssl/private/weft.example.org.key.

table <weft> { 127.0.0.1 }

# Health-checked variant: relayd polls weft's /api/healthz, which answers 200
# while the LDAP server is reachable and 503 while it is not, and takes the host
# out of the table on failure. Worth enabling when the table holds more than one
# weft host, so requests fail over to a healthy one.
#
# On a single-host table the trade-off runs the other way: relayd would answer
# every request with its own error page for as long as LDAP is unreachable,
# whereas weft itself renders "Verbindung fehlgeschlagen / Connection failed"
# with a retry button and serves the login screen again the moment the directory
# is back. Leave the plain table above in that case and monitor /api/healthz
# out-of-band instead.
#
# table <weft> { 127.0.0.1 check http "/api/healthz" code 200 }

http protocol "wefttls" {
	tls keypair "weft.example.org"

	# Forward the real client IP so weft's login rate limit keys on it.
	match request header set "X-Forwarded-For" value "$REMOTE_ADDR"

	# Security headers (weft also sets some itself).
	match response header set "Strict-Transport-Security" value "max-age=31536000"

	pass
}

relay "weft_https" {
	listen on egress port 443 tls
	protocol "wefttls"
	forward to <weft> port 8080
}
